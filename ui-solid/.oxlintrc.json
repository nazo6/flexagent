{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-empty": ["error", { "allowEmptyCatch": false }]
  },
  "ignorePatterns": ["src/lib/generated/**", "src/lib/paraglide/**", "dist/**", "node_modules/**"]
}
