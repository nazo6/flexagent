{
  "lineWidth": 80,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "maintainAndWrap",
    "wrapCodeSpans": false,
    "wrapUnspacedScripts": false
  },
  "includes": [
    "**/*.md"
  ],
  "excludes": [
    "target/**",
    "ui/node_modules/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.24.0.wasm"
  ]
}
