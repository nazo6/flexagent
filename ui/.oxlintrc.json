{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-empty": ["error", { "allowEmptyCatch": false }]
  },
  "ignorePatterns": [
    "src/lib/generated/**",
    "src/lib/paraglide/**",
    ".svelte-kit/**",
    "build/**",
    "node_modules/**"
  ]
}
