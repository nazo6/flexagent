  "query": "\n        SELECT id, created_at, last_seen_at, level, code, summary, details_json,\n               session_id, node_id, request_id, source, occurrence_count, resolved_at\n          FROM incidents\n         WHERE ? OR resolved_at IS NULL\n         ORDER BY last_seen_at DESC\n         LIMIT ?\n        ",
